# Devcontainer specific ignores
.devcontainer/tmp/
.devcontainer/logs/
.devcontainer/cache/

# VS Code settings that might be generated
.vscode/settings.json.backup

# Development artifacts
*.log
*.tmp

# Node.js dependencies (if accidentally created in devcontainer)
node_modules/
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
